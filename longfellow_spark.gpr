with "config/longfellow_spark_config.gpr";
project Longfellow_Spark is

   for Library_Name use "Longfellow_Spark";
   for Library_Version use Project'Library_Name & ".so." & Longfellow_Spark_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Longfellow_Spark_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("LONGFELLOW_SPARK_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Longfellow_Spark_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Proof configuration (ADR 0003 as amended by ADR 0018): the three
   --  provers of level 2 with a step budget, so that a proof that fits
   --  the budget on one machine fits it on every machine, and a
   --  wall-clock timeout as a safety net. The budget sits above the
   --  429702 steps of the hardest proof observed; the timeout is four
   --  times the longest successful attempt observed, and is necessary:
   --  Alt-Ergo does not always honour its step bound (two goals of
   --  Lemma_Solinas ran for over seven hours with --timeout=0).
   package Prove is
      for Proof_Switches ("Ada") use
        ("--prover=cvc5,z3,altergo", "--steps=600000", "--timeout=20",
         "--memlimit=1000", "--report=all");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Longfellow_Spark;
