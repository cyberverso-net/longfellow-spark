/-
Vectors of the model of the field over `Nat` (`LongfellowSpark.GF128.mul` and
the constants of `LongfellowSpark.Model`), checked against `GF2_128.Mul` and
the constants of `Gadgets.Words` by the test `gadgets_kat`.

Run from `lean/` with
  lake env lean scripts/Vectors.lean > ../tests/vectors/lean_gf2_128.txt
Each element is 32 hexadecimal digits, the coefficient of x ^ 127 first, as in
`tests/vectors/gf2_128_mul.txt`.
-/
import LongfellowSpark.Model

open LongfellowSpark

def hex32 (n : Nat) : String :=
  let d := String.ofList (Nat.toDigits 16 n)
  String.ofList (List.replicate (32 - d.length) '0') ++ d

/-- A linear congruential sequence over 128 bits, for operands spread over
the whole field. -/
def next (s : Nat) : Nat := (s * 0x2360ed051fc65da44385df649fccf645 + 0x5851f42d4c957f2d) % 2 ^ 128

def mulLines : Nat → Nat → List String
  | 0, _ => []
  | n + 1, s =>
    let a := next s
    let b := next a
    s!"mul {hex32 a} {hex32 b} {hex32 (GF128.mul a b)}" :: mulLines n b

def edgeLines : List String :=
  let edges := [0, 1, 2, 2 ^ 127, 2 ^ 128 - 1, 2 ^ 64, 2 ^ 64 - 1, 0x87]
  edges.flatMap fun a => edges.map fun b =>
    s!"mul {hex32 a} {hex32 b} {hex32 (GF128.mul a b)}"

def alphaLines : List String :=
  (List.range 33).map fun i => s!"alpha2 {i} {hex32 (Model.alpha2 i)}"

def shiftLines : List String :=
  (List.range 7).map fun i => s!"shift {i} {hex32 (Model.shift i)}"

#eval do
  IO.println "# Vectors of the Lean model of GF(2^128) (lean/scripts/Vectors.lean)."
  IO.println "# Generated by: cd lean && lake env lean scripts/Vectors.lean"
  IO.println "# Do not edit by hand."
  for l in edgeLines ++ mulLines 64 1 ++ alphaLines ++ shiftLines do
    IO.println l
