--  longfellow_verify: the command-line verifier of Phase B (ADR 0046),
--  the interop harness interop_kat (ADR 0048) and the command-line
--  prover longfellow_prove of Phase C (ADR 0049), all outside the proof
--  perimeter. The library sources are compiled here without
--  assertions (the proofs establish what the contracts state) and, by
--  default, without run-time checks in the units of src/, whose absence
--  of run-time errors is proved (ADR 0068), with optimisation: this is
--  the build to run on real circuits and proofs, and the interop test
--  runs on the same binary code the project delivers. The
--  assertion-enabled build of tests/ would execute the stage 3
--  contracts on thousands of inputs and take the better part of an
--  hour on one circuit.
--
--  Build:  alr exec -- gprbuild -P cli/longfellow_verify.gpr -p -s
--  Run:    cli/bin/longfellow_verify --help
--          cli/bin/longfellow_prove --help
--          cli/bin/interop_kat [vector files]

with "sparklib";

project Longfellow_Verify is

   --  LONGFELLOW_CLI_BUILD, described at package Compiler.
   type Build_Kind is ("o2", "o3", "proved");
   Build : Build_Kind := external ("LONGFELLOW_CLI_BUILD", "proved");

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj/" & Build;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("longfellow_verify.adb", "interop_kat.adb", "longfellow_prove.adb",
      "first_step_bench.adb");

   --  The build, chosen with LONGFELLOW_CLI_BUILD:
   --  o2     -O2, every run-time check on (the build until ADR 0068);
   --  o3     -O3 and inlining across units, every check on;
   --  proved the default: as o3, with the run-time checks suppressed
   --         in the library units of src/, whose absence of run-time
   --         errors is proved; the units of cli/src/, outside the
   --         proof, keep them (ADR 0068). Every source of cli/src/ has
   --         its line below; scripts/check.sh cli checks the switches
   --         each unit was actually compiled with.
   Common := ("-gnat2022", "-gnatwa", "-gnatW8",
              "-gnaty3aAbBcefhiIklmnOprStux");
   Fast := Common & ("-O3", "-gnatn");

   package Compiler is
      case Build is
         when "o2" =>
            for Default_Switches ("Ada") use Common & ("-O2");
         when "o3" =>
            for Default_Switches ("Ada") use Fast;
         when "proved" =>
            for Default_Switches ("Ada") use Fast & ("-gnatp");
            for Switches ("cli_random.adb") use Fast;
            for Switches ("cli_random.ads") use Fast;
            for Switches ("first_step_bench.adb") use Fast;
            for Switches ("interop_kat.adb") use Fast;
            for Switches ("ligero_prover_cli_gf2_128.ads") use Fast;
            for Switches ("ligero_prover_cli_p256.ads") use Fast;
            for Switches ("longfellow_prove.adb") use Fast;
            for Switches ("longfellow_verify.adb") use Fast;
            for Switches ("os_random.adb") use Fast;
            for Switches ("os_random.ads") use Fast;
            for Switches ("pinned_circuits.adb") use Fast;
            for Switches ("pinned_circuits.ads") use Fast;
            for Switches ("sampling_cli_gf2_128.ads") use Fast;
            for Switches ("sampling_cli_p256.ads") use Fast;
            for Switches ("sumcheck_prover_cli_gf2_128.ads") use Fast;
            for Switches ("sumcheck_prover_cli_p256.ads") use Fast;
            for Switches ("zk_prover_cli_gf2_128.ads") use Fast;
            for Switches ("zk_prover_cli_p256.ads") use Fast;
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Longfellow_Verify;
