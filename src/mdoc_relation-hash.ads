--  Mdoc_Relation.Hash: the relation of the hash circuit of the version
--  7 pair, one attribute (ADR 0091, piece 1). The registered circuit
--  is 8d079211..., generated by upstream's
--  lib/circuits/mdoc/mdoc_generate_circuit.cc at
--  longfellow-zk/longfellow-zk 0d92f80c, lines 133 to 169, from
--  lib/circuits/mdoc/mdoc_hash.h, assert_valid_hash_mdoc. Every
--  clause below cites the lines of the generator it transcribes, at
--  that commit; a file without a directory is in lib/circuits/mdoc/.
--
--  The relation is stated as the circuit checks it, not as the CBOR
--  structure would suggest. The circuit does not parse the MSO: it
--  looks for fixed byte patterns at offsets the prover chooses, inside
--  the bytes the issuer signed (matching by content). What makes that
--  reading a statement about a credential is a set of hypotheses on
--  the issuer and the relying party, kept outside the relation; the
--  conditions table of chapter 10 names them (H_ for a hypothesis,
--  Fact_ for a fact about the circuit that the checker establishes,
--  Limit_ for a known limit).
--
--  Three layers:
--
--    1. The decoding. Decode_Public reads the 952 public elements,
--       Decode_Private the private part. A byte is read from its
--       eight elements, least significant bit first, an element
--       counting as 1 when it equals One. The clause Bits says when
--       that reading is faithful.
--    2. The clauses, one expression function each, over the decoded
--       parts. Clause_Holds names them.
--    3. Hash_Relation, the conjunction. It names no public value
--       outside Decode_Public.
--
--  Only version 7 and one attribute. A second version or a second
--  attribute is a new child.
--
--  Documentation: docs/guide/10-certified-circuits.md, Section 1;
--  docs/guide/09-mdoc.md, Section 3.7 (the witness) and Section 6
--  (the conditions for certifying the circuit).
--
--  Proof status (Silver = absence of run-time errors, Gold = proved
--  functional contracts).
--
--    Everything : Silver, for any X and W of the shape Shape_Ok
--                 states. Counts_Agree is proved: the shape is the
--                 count of Mdoc_Inputs and Mdoc_Witness.
--    The lemmas : Gold. Lemma_Byte_At (a byte laid out as its bits
--                 decodes to itself), Lemma_Count_In_Range and
--                 Lemma_Item_No_Wrap (consequences of the clauses),
--                 proved for all inputs.
--
--  Tested: that the relation holds on the honest witness of every
--  test document the circuit accepts, and that a mutation of the
--  witness fails the clause it aims at; that Decode_Public of the
--  public inputs Mdoc_Inputs.Hash_Inputs builds is the request they
--  encode (harness relation_cases, on every honest case).
--  Trusted: that the clauses are the generator's checks, by reading
--  (the author's review, chapter 10, Section 1); that the circuit file
--  is what the generator emits is the subject of the milestone's later
--  blocks (register row R2).
--
--  Constant time: NOT APPLICABLE. The package is ghost and is never
--  compiled into the library.

pragma SPARK_Mode (On);

with Interfaces;    use Interfaces;
with Bytes;         use Bytes;
with GF2_128;
with Sha256;
with Sha256.Trace;
with Mdoc_Mac;
with Mdoc_Inputs;
with Mdoc_Witness;
with Sumcheck_Algebra_GF2_128;

package Mdoc_Relation.Hash is

   package SAH renames Sumcheck_Algebra_GF2_128;

   use type GF2_128.Element;

   subtype Element is GF2_128.Element;

   ----------------------------------------------------------------------
   --  The shape of the inputs
   ----------------------------------------------------------------------

   Public_Count  : constant := 952;
   Private_Count : constant := 84_166;

   --  The counts are those of the encoders (register rows R8, R14).
   function Counts_Agree return Boolean is
     (Public_Count = Mdoc_Inputs.Hash_Count (7, 1)
      and then Private_Count = Mdoc_Witness.Hash_Count (7, 1))
   with Global => null, Post => Counts_Agree'Result;

   function Shape_Ok (X, W : SAH.Element_Array) return Boolean is
     (X'First = 0 and then X'Last = Public_Count - 1
      and then W'First = 0 and then W'Last = Private_Count - 1)
   with Global => null;

   ----------------------------------------------------------------------
   --  The positions
   ----------------------------------------------------------------------

   --  The public inputs, in the order of the circuit file:
   --  mdoc_generate_circuit.cc 133 to 147, and OpenedAttribute,
   --  mdoc_hash.h 61 to 79.
   X_One       : constant := 0;      --  the constant one
   X_Id        : constant := 1;      --  attr, 32 bytes: the CBOR text
                                     --  of the identifier, zero bytes
                                     --  after it
   X_Value     : constant := 257;    --  v1, 64 bytes: the CBOR value
   X_Id_Len    : constant := 769;    --  len, 8 bits: 1 + 17 + 1 + id_len
   X_Value_Len : constant := 777;    --  vlen, 8 bits: value_len + 12 + 1
   X_Now       : constant := 785;    --  now, 20 bytes
   X_Tags      : constant := 945;    --  the six tags, one element each
   X_Av        : constant := 951;    --  av, one element

   --  The private inputs: mdoc_generate_circuit.cc 149 to 161, and the
   --  Witness, mdoc_hash.h 145 to 174.
   W_E             : constant := 0;       --  e, 256 bits
   W_Dpk_X         : constant := 256;     --  the device key's x, 256 bits
   W_Dpk_Y         : constant := 512;     --  its y, 256 bits
   W_Count         : constant := 768;     --  nb_, 8 bits
   W_Message       : constant := 776;     --  in_, 2,542 bytes
   W_Blocks        : constant := 21_112;  --  sig_sha_, 40 block traces
   W_Valid_From    : constant := 79_992;  --  four indices, 12 bits each
   W_Valid_Until   : constant := 80_004;
   W_Device_Key    : constant := 80_016;
   W_Value_Digests : constant := 80_028;
   W_Item          : constant := 80_040;  --  attrb_, 128 bytes
   W_Item_Blocks   : constant := 81_064;  --  attr_sha_, 2 block traces
   W_Digest_Index  : constant := 84_008;  --  attr_mso_, 12 bits
   W_Ei            : constant := 84_020;  --  attr_ei_, attr_ev_: 24 bits
   W_Ev            : constant := 84_044;  --  each, read only at version 6
   W_Slots         : constant := 84_068;  --  i1, i2, i3, 12 bits each
   W_Slot_Lengths  : constant := 84_104;  --  l[0 .. 3], 12 bits each
   W_Perm          : constant := 84_152;  --  perm, 8 bits
   W_Pads          : constant := 84_160;  --  the six pads, one element
                                          --  each

   ----------------------------------------------------------------------
   --  1. The decoding
   ----------------------------------------------------------------------

   --  An element that is a bit, and the bit it is read as.
   function Is_Bit (E : Element) return Boolean is
     (E = GF2_128.Zero or else E = GF2_128.One)
   with Global => null;

   function Bit_Value (E : Element) return Unsigned_8 is
     (if E = GF2_128.One then 1 else 0)
   with Global => null;

   function Bits_In
     (A : SAH.Element_Array; First, Count : Natural) return Boolean
   is
     (for all I in First .. First + Count - 1 => Is_Bit (A (I)))
   with Global => null,
        Pre => A'First = 0 and then First <= A'Length
               and then Count <= A'Length - First;

   --  The byte of the eight elements from Pos, least significant bit
   --  first (Logic::vinput<8>).
   function Byte_At (A : SAH.Element_Array; Pos : Natural) return Unsigned_8
   is
     (Bit_Value (A (Pos)) + 2 * Bit_Value (A (Pos + 1))
      + 4 * Bit_Value (A (Pos + 2)) + 8 * Bit_Value (A (Pos + 3))
      + 16 * Bit_Value (A (Pos + 4)) + 32 * Bit_Value (A (Pos + 5))
      + 64 * Bit_Value (A (Pos + 6)) + 128 * Bit_Value (A (Pos + 7)))
   with Global => null,
        Pre => Pos >= A'First and then A'Last >= 7 and then Pos <= A'Last - 7;

   --  The eight elements from Pos laid out as the bits of V, least
   --  significant first, each One or Zero: the layout the encoder and
   --  the builder write (Mdoc_Inputs, Mdoc_Witness).
   function Byte_Layout
     (A : SAH.Element_Array; Pos : Natural; V : Unsigned_8) return Boolean
   is
     (for all B in 0 .. 7 =>
        A (Pos + B) =
          (if (Shift_Right (V, B) and 1) = 1 then GF2_128.One
           else GF2_128.Zero))
   with Global => null,
        Pre => Pos >= A'First and then A'Last >= 7 and then Pos <= A'Last - 7;

   --  An index of the witness: 12 bits, least significant first
   --  (vinput<kCborIndexBits>, mdoc_constants.h 28).
   subtype Index_12 is Natural range 0 .. 4_095;

   function Index_At (A : SAH.Element_Array; Pos : Natural) return Index_12
   is
     (Natural (Byte_At (A, Pos))
      + 256 * (Natural (Bit_Value (A (Pos + 8)))
               + 2 * Natural (Bit_Value (A (Pos + 9)))
               + 4 * Natural (Bit_Value (A (Pos + 10)))
               + 8 * Natural (Bit_Value (A (Pos + 11)))))
   with Global => null,
        Pre => Pos >= A'First and then A'Last >= 11
               and then Pos <= A'Last - 11;

   subtype Date_Bytes is Byte_Array (0 .. 19);

   --  The public part.
   type Public_Part is record
      Id        : Bytes_32;
      Value     : Bytes_64;
      Id_Len    : Unsigned_8;
      Value_Len : Unsigned_8;
      Now       : Date_Bytes;
      Tags      : Mdoc_Mac.Tags;
      Av        : Element;
   end record;

   function Decode_Public (X : SAH.Element_Array) return Public_Part is
     (Public_Part'
        (Id        => [for I in 0 .. 31 => Byte_At (X, X_Id + 8 * I)],
         Value     => [for I in 0 .. 63 => Byte_At (X, X_Value + 8 * I)],
         Id_Len    => Byte_At (X, X_Id_Len),
         Value_Len => Byte_At (X, X_Value_Len),
         Now       => [for I in 0 .. 19 => Byte_At (X, X_Now + 8 * I)],
         Tags      => [for I in Mdoc_Mac.Tag_Index => X (X_Tags + I)],
         Av        => X (X_Av)))
   with Global => null,
        Pre => X'First = 0 and then X'Last = Public_Count - 1;

   --  The private part the relation reads. The 40 traces of the signed
   --  message and the two of the item are not decoded: the relation
   --  recomputes the compression they witness (the clauses Chain and
   --  Value_Digest), and asserts nothing else of them.
   Max_Blocks    : constant := Sha256.Trace.Max_Blocks;    --  kMaxSHABlocks
   Prefix_Length : constant := 18;                         --  kCose1PrefixLen
   Message_Bytes : constant := 64 * Max_Blocks - Prefix_Length;  --  2,542

   subtype Message_Array is Byte_Array (0 .. Message_Bytes - 1);
   subtype Item_Array is Byte_Array (0 .. 127);

   subtype Slot is Natural range 0 .. 3;
   type Slot_Indices is array (Slot) of Index_12;

   type Private_Part is record
      E          : Bytes_32;         --  little-endian, as the witness
      Dpk_X      : Bytes_32;         --  holds them
      Dpk_Y      : Bytes_32;
      Count      : Unsigned_8;       --  nb_
      Message    : Message_Array;    --  in_
      Valid_From    : Index_12;
      Valid_Until   : Index_12;
      Device_Key    : Index_12;
      Value_Digests : Index_12;
      Item          : Item_Array;    --  attrb_
      Digest_Index  : Index_12;      --  attr_mso_
      Starts        : Slot_Indices;  --  5, i1, i2, i3
      Lengths       : Slot_Indices;  --  l[0 .. 3]
      Perm          : Unsigned_8;
      --  mac_ap, in the order of Mdoc_Inputs.Witness_Parts.
      Pads          : Mdoc_Mac.Pads;
   end record;

   function Decode_Private (W : SAH.Element_Array) return Private_Part is
     (Private_Part'
        (E       => [for I in 0 .. 31 => Byte_At (W, W_E + 8 * I)],
         Dpk_X   => [for I in 0 .. 31 => Byte_At (W, W_Dpk_X + 8 * I)],
         Dpk_Y   => [for I in 0 .. 31 => Byte_At (W, W_Dpk_Y + 8 * I)],
         Count   => Byte_At (W, W_Count),
         Message =>
           [for I in 0 .. Message_Bytes - 1 => Byte_At (W, W_Message + 8 * I)],
         Valid_From    => Index_At (W, W_Valid_From),
         Valid_Until   => Index_At (W, W_Valid_Until),
         Device_Key    => Index_At (W, W_Device_Key),
         Value_Digests => Index_At (W, W_Value_Digests),
         Item          => [for I in 0 .. 127 => Byte_At (W, W_Item + 8 * I)],
         Digest_Index  => Index_At (W, W_Digest_Index),
         Starts        =>
           [0 => 5,
            1 => Index_At (W, W_Slots),
            2 => Index_At (W, W_Slots + 12),
            3 => Index_At (W, W_Slots + 24)],
         Lengths       =>
           [for S in Slot => Index_At (W, W_Slot_Lengths + 12 * S)],
         Perm          => Byte_At (W, W_Perm),
         Pads          =>
           [for I in Mdoc_Mac.Message_Index =>
              [for H in Mdoc_Mac.Half_Index => W (W_Pads + 2 * I + H)]]))
   with Global => null,
        Pre => W'First = 0 and then W'Last = Private_Count - 1;

   ----------------------------------------------------------------------
   --  The signed message
   ----------------------------------------------------------------------

   --  The 18 bytes the circuit places before in_, the COSE_Sign1
   --  Sig_structure up to the byte-string head of the payload: 84
   --  (array of 4), 6A "Signature1", 43 A1 01 26 (the protected header,
   --  alg ES256), 40 (empty external data), 59 (a byte string with a
   --  two-byte length). The circuit builds the preimage with these
   --  constants and asserts nothing about them: they are part of the
   --  decoding (construct_signature_preimage, mdoc_hash.h 287 to 297;
   --  kCose1Prefix, mdoc_constants.h 32 to 36).
   Prefix : constant Byte_Array (0 .. Prefix_Length - 1) :=
     [16#84#, 16#6A#,
      16#53#, 16#69#, 16#67#, 16#6E#, 16#61#,      --  "Signa"
      16#74#, 16#75#, 16#72#, 16#65#, 16#31#,      --  "ture1"
      16#43#, 16#A1#, 16#01#, 16#26#, 16#40#, 16#59#];

   subtype Preimage_Index is Natural range 0 .. 64 * Max_Blocks - 1;

   function Preimage_Byte
     (V : Private_Part; I : Preimage_Index) return Unsigned_8
   is
     (if I < Prefix_Length then Prefix (I) else V.Message (I - Prefix_Length))
   with Global => null;

   subtype Block_Index is Natural range 0 .. Max_Blocks - 1;

   function Block (V : Private_Part; B : Block_Index) return Bytes_64 is
     ([for J in 0 .. 63 => Preimage_Byte (V, 64 * B + J)])
   with Global => null;

   --  The state of the compression iterated from the initial value over
   --  the first N blocks of the preimage (flatsha256_circuit.h 192 to
   --  218: the bytes of a block read as big-endian words, 204 and 205).
   function State_After (V : Private_Part; N : Natural) return Sha256.State
   is
     (if N = 0 then Sha256.Initial_State
      else Sha256.Trace.Compress (State_After (V, N - 1), Block (V, N - 1)))
   with Global => null,
        Pre => N <= Max_Blocks,
        Subprogram_Variant => (Decreases => N);

   --  The 32 bytes of a state in the order of FIPS 180-4 (H0 first,
   --  each word big-endian), as Sha256.Digest returns them.
   function Digest_Of (S : Sha256.State) return Bytes_32 is
     ([for I in 0 .. 31 =>
         Unsigned_8 (Shift_Right (S (Sha256.Word_Index (I / 4)),
                                  24 - 8 * (I mod 4)) and 16#FF#)])
   with Global => null;

   --  The state the circuit compares with e: the state after block nb
   --  when nb is 1 to 40; the sum of no state, zero, otherwise
   --  (assert_hash, flatsha256_circuit.h 236 to 262).
   function Signed_Digest (V : Private_Part) return Bytes_32 is
     (if V.Count in 1 .. Max_Blocks
      then Digest_Of (State_After (V, Natural (V.Count)))
      else [others => 0])
   with Global => null;

   --  A 64-bit big-endian length.
   function Be_64 (B : Bytes_8) return Unsigned_64 is
     (Shift_Left (Unsigned_64 (B (0)), 56)
      or Shift_Left (Unsigned_64 (B (1)), 48)
      or Shift_Left (Unsigned_64 (B (2)), 40)
      or Shift_Left (Unsigned_64 (B (3)), 32)
      or Shift_Left (Unsigned_64 (B (4)), 24)
      or Shift_Left (Unsigned_64 (B (5)), 16)
      or Shift_Left (Unsigned_64 (B (6)), 8) or Unsigned_64 (B (7)))
   with Global => null;

   --  The bit length in the last eight bytes of block nb, zero when nb
   --  is not 1 to 40 (find_len, flatsha256_circuit.h 282 to 295).
   function Signed_Length (V : Private_Part) return Unsigned_64 is
     (if V.Count in 1 .. Max_Blocks
      then Be_64 ([for J in 0 .. 7 =>
                     Preimage_Byte (V, 64 * Natural (V.Count) - 8 + J)])
      else 0)
   with Global => null;

   --  A length the circuit accepts: whole bytes, below 4,096 bytes
   --  (extract_vind, mdoc_hash.h 299 to 312: bits 0 to 2 and 15 to 63
   --  are zero); the length in bytes is bits 3 to 14.
   function Length_Ok (L : Unsigned_64) return Boolean is
     (L mod 8 = 0 and then L < 2 ** 15)
   with Global => null;

   function Byte_Length (L : Unsigned_64) return Index_12 is
     (Natural (L / 8))
   with Global => null, Pre => Length_Ok (L);

   ----------------------------------------------------------------------
   --  The windows into the MSO
   ----------------------------------------------------------------------

   --  The circuit reads the MSO from in_ + 7, past the two bytes of the
   --  payload's length and the five of D8 18 59 and its own length
   --  (mdoc_hash.h 198 to 200), over kMaxMsoLen bytes; a byte past
   --  them reads as zero (Routing::shift, routing.h 214 to 257; zz,
   --  mdoc_hash.h 194).
   Max_Mso_Len : constant := 64 * Max_Blocks - 9 - Prefix_Length;  --  2,533

   subtype Window_Offset is Natural range 0 .. 99;

   function Mso_At
     (V : Private_Part; K : Index_12; I : Window_Offset) return Unsigned_8
   is
     (if K + I < Max_Mso_Len then V.Message (7 + K + I) else 0)
   with Global => null;

   function Matches
     (V : Private_Part; K : Index_12; Offset : Window_Offset;
      Pattern : Byte_Array) return Boolean
   is
     (for all I in 0 .. Pattern'Length - 1 =>
        Mso_At (V, K, Offset + I) = Pattern (Pattern'First + I))
   with Global => null,
        Pre => Pattern'Length <= 100 - Offset;

   --  The patterns, mdoc_hash.h 508 to 540 and mdoc_constants.h 50.
   --  69 "validFrom" C0 74: text(9), tag 0, text(20).
   Valid_From_Key : constant Byte_Array (0 .. 11) :=
     [16#69#, 16#76#, 16#61#, 16#6C#, 16#69#, 16#64#, 16#46#, 16#72#,
      16#6F#, 16#6D#, 16#C0#, 16#74#];

   --  6A "validUntil" C0 74.
   Valid_Until_Key : constant Byte_Array (0 .. 12) :=
     [16#6A#, 16#76#, 16#61#, 16#6C#, 16#69#, 16#64#, 16#55#, 16#6E#,
      16#74#, 16#69#, 16#6C#, 16#C0#, 16#74#];

   --  6D "deviceKeyInfo" A1 69 "deviceKey" A4 01 02 20 01 21 58 20:
   --  a map of one entry, deviceKey, a COSE_Key of four entries, kty 2,
   --  crv 1, then the key -2 and the head of x, a byte string of 32.
   Device_Key_Key : constant Byte_Array (0 .. 32) :=
     [16#6D#, 16#64#, 16#65#, 16#76#, 16#69#, 16#63#, 16#65#, 16#4B#,
      16#65#, 16#79#, 16#49#, 16#6E#, 16#66#, 16#6F#, 16#A1#, 16#69#,
      16#64#, 16#65#, 16#76#, 16#69#, 16#63#, 16#65#, 16#4B#, 16#65#,
      16#79#, 16#A4#, 16#01#, 16#02#, 16#20#, 16#01#, 16#21#, 16#58#,
      16#20#];

   --  22 58 20: the key -3 and the head of y.
   Device_Key_Y_Key : constant Byte_Array (0 .. 2) := [16#22#, 16#58#, 16#20#];

   --  6C "valueDigests".
   Value_Digests_Key : constant Byte_Array (0 .. 12) :=
     [16#6C#, 16#76#, 16#61#, 16#6C#, 16#75#, 16#65#, 16#44#, 16#69#,
      16#67#, 16#65#, 16#73#, 16#74#, 16#73#];

   --  58 20: a byte string of 32 (kTag32).
   Digest_Head : constant Byte_Array (0 .. 1) := [16#58#, 16#20#];

   --  The lexicographic order of two dates, byte by byte (Memcmp::leq,
   --  memcmp.h 46 to 63: the bytes as one big-endian number).
   function Date_Leq (A, B : Date_Bytes) return Boolean is
     ((for all I in Date_Bytes'Range => A (I) = B (I))
      or else
        (for some I in Date_Bytes'Range =>
           A (I) < B (I)
           and then (for all J in 0 .. I - 1 => A (J) = B (J))))
   with Global => null;

   function Date_At (V : Private_Part; K : Index_12; Offset : Natural)
     return Date_Bytes
   is
     ([for I in Date_Bytes'Range => Mso_At (V, K, Offset + I)])
   with Global => null, Pre => Offset <= 80;

   ----------------------------------------------------------------------
   --  The issuer-signed item
   ----------------------------------------------------------------------

   --  The digest of the item's two blocks, chained from the initial
   --  value, with no padding checked (assert_message_hash with nb = 2,
   --  mdoc_hash.h 273 to 275).
   --
   --  Two blocks always, and that is not a condition on the issuer: a
   --  message of 55 bytes or fewer hashes in one block, 56 to 119 in
   --  two. The smallest item the clause Item admits is 56 bytes: the
   --  five of D8 18 58 LL A4, digestID with a one-byte value (10),
   --  random as an empty byte string (8), elementIdentifier with an
   --  empty text (19), elementValue with a one-byte value (14). With
   --  the 16 bytes of random that ISO/IEC 18013-5 9.1.2.5 requires, it
   --  is 72. An item above 119 bytes cannot be proved (completeness).
   function Item_Digest (V : Private_Part) return Bytes_32 is
     (Digest_Of
        (Sha256.Trace.Compress
           (Sha256.Trace.Compress (Sha256.Initial_State, V.Item (0 .. 63)),
            V.Item (64 .. 127))))
   with Global => null;

   --  The bit length in the item's last eight bytes (find_len with
   --  nb = 2, mdoc_hash.h 278).
   function Item_Length (V : Private_Part) return Unsigned_64 is
     (Be_64 (V.Item (120 .. 127)))
   with Global => null;

   --  The four entries of the item, and the slot the permutation gives
   --  each: bits 2F and 2F + 1 of perm, low bit first (mux_offset,
   --  mdoc_hash.h 478 to 489).
   subtype Field is Natural range 0 .. 3;
   Digest_Id_Field  : constant Field := 0;
   Random_Field     : constant Field := 1;
   Identifier_Field : constant Field := 2;
   Value_Field      : constant Field := 3;

   function Slot_Of (V : Private_Part; F : Field) return Slot is
     (Natural (Shift_Right (V.Perm, 2 * F) and 3))
   with Global => null;

   function Field_Start (V : Private_Part; F : Field) return Index_12 is
     (V.Starts (Slot_Of (V, F)))
   with Global => null;

   function Field_Length (V : Private_Part; F : Field) return Index_12 is
     (V.Lengths (Slot_Of (V, F)))
   with Global => null;

   --  Byte T of the window at the field's start, over the 128 bytes of
   --  the item, zero past them (r_.shift over MAX_BUF = 119 bytes,
   --  mdoc_hash.h 422, 429, 435, 452 and 466).
   subtype Got_Index is Natural range 0 .. 118;

   function Got (V : Private_Part; F : Field; T : Got_Index) return Unsigned_8
   is
     (if Field_Start (V, F) + T < 128 then V.Item (Field_Start (V, F) + T)
      else 0)
   with Global => null;

   --  68 "digestID"; 66 "random"; 71 "elementIdentifier";
   --  6C "elementValue" (kDigestID and kRandomID, mdoc_constants.h 78
   --  to 82; ei_bytes and ev_bytes, mdoc_hash.h 442 to 445).
   Digest_Id_Key : constant Byte_Array (0 .. 8) :=
     [16#68#, 16#64#, 16#69#, 16#67#, 16#65#, 16#73#, 16#74#, 16#49#,
      16#44#];

   Random_Key : constant Byte_Array (0 .. 6) :=
     [16#66#, 16#72#, 16#61#, 16#6E#, 16#64#, 16#6F#, 16#6D#];

   Identifier_Key : constant Byte_Array (0 .. 17) :=
     [16#71#, 16#65#, 16#6C#, 16#65#, 16#6D#, 16#65#, 16#6E#, 16#74#,
      16#49#, 16#64#, 16#65#, 16#6E#, 16#74#, 16#69#, 16#66#, 16#69#,
      16#65#, 16#72#];

   Value_Key : constant Byte_Array (0 .. 12) :=
     [16#6C#, 16#65#, 16#6C#, 16#65#, 16#6D#, 16#65#, 16#6E#, 16#74#,
      16#56#, 16#61#, 16#6C#, 16#75#, 16#65#];

   --  The CBOR head byte as the circuit decodes it: the major type in
   --  the top three bits, the count in the low five
   --  (CborByteDecoder::decode_one_v8,
   --  circuits/cbor_parser/cbor_byte_decoder.h 67 to 113).
   function Major (B : Unsigned_8) return Natural is (Natural (B / 32))
   with Global => null;

   function Count_Of (B : Unsigned_8) return Natural is (Natural (B mod 32))
   with Global => null;

   --  Not invalid: a special (7) only as a simple value (count 20 to
   --  23); a count of 25 to 27 only for an integer or a tag (major 0, 1
   --  or 6); never 28 to 31.
   function Head_Valid (B : Unsigned_8) return Boolean is
     ((if Major (B) = 7 then Count_Of (B) in 20 .. 23)
      and then (Count_Of (B) <= 24
                or else (Major (B) in 0 | 1 | 6
                         and then Count_Of (B) in 25 .. 27)))
   with Global => null;

   --  A string whose length is in the next byte.
   function Length_Plus_Next (B : Unsigned_8) return Boolean is
     (Major (B) in 2 | 3 and then Count_Of (B) = 24)
   with Global => null;

   --  The head of an atom (digestID): 1, 2, 3 or 5 bytes as the count
   --  is 0 to 23 (or above 27, refused by Head_Valid), 24, 25, 26.
   function Atom_Head_Length (B : Unsigned_8) return Natural is
     (case Count_Of (B) is
         when 24     => 2,
         when 25     => 3,
         when 26     => 5,
         when others => 1)
   with Global => null;

   --  The field's length agrees with the CBOR head at byte H of its
   --  window: the key's H bytes, the head of the value and the value's
   --  own length; an atom has no length of its own, and a count of 27
   --  is refused (check_cbor_length, mdoc_hash.h 351 to 388). The type
   --  of the value is not checked (hypothesis H_Types_In_Item).
   function Cbor_Length_Ok
     (V : Private_Part; F : Field; H : Natural; Atom : Boolean) return Boolean
   is
     (Head_Valid (Got (V, F, H))
      and then
        (if Atom then
           Count_Of (Got (V, F, H)) /= 27
           and then Field_Length (V, F) = H + Atom_Head_Length (Got (V, F, H))
         elsif Length_Plus_Next (Got (V, F, H)) then
           Field_Length (V, F) = H + 2 + Natural (Got (V, F, H + 1))
         else
           Field_Length (V, F) = H + 1 + Count_Of (Got (V, F, H))))
   with Global => null, Pre => H <= 9;

   --  The public text of the entry: the key, then the public bytes
   --  (format_element, mdoc_hash.h 330 to 342).
   function Want_Identifier (P : Public_Part; J : Natural) return Unsigned_8
   is
     (if J < 18 then Identifier_Key (J) else P.Id (J - 18))
   with Global => null, Pre => J <= 49;

   function Want_Value (P : Public_Part; J : Natural) return Unsigned_8 is
     (if J < 13 then Value_Key (J) else P.Value (J - 13))
   with Global => null, Pre => J <= 76;

   ----------------------------------------------------------------------
   --  2. The clauses
   ----------------------------------------------------------------------

   --  Every element the circuit takes as a bit is 0 or 1: Logic::input
   --  asserts it of every bit input, public ones included
   --  (circuits/logic/logic.h 976 to 980, 985 to 990). Not bits: the
   --  constant one, the tags and av (eltw_input), the block traces
   --  (plucked) and the pads.
   function Bits (X, W : SAH.Element_Array) return Boolean is
     (Bits_In (X, X_Id, X_Tags - X_Id)
      and then Bits_In (W, W_E, W_Blocks - W_E)
      and then Bits_In (W, W_Valid_From, W_Item_Blocks - W_Valid_From)
      and then Bits_In (W, W_Digest_Index, W_Pads - W_Digest_Index))
   with Global => null, Pre => Shape_Ok (X, W);

   --  e is the state after block nb of the compression iterated over
   --  the preimage, e's little-endian bytes the digest reversed
   --  (assert_message_hash, mdoc_hash.h 187 and 188;
   --  flatsha256_circuit.h 225 to 262, the order at 259).
   function Chain (V : Private_Part) return Boolean is
     (for all I in 0 .. 31 => V.E (I) = Signed_Digest (V) (31 - I))
   with Global => null;

   --  Every block from block nb on is zero (assert_zero_padding,
   --  flatsha256_circuit.h 267 to 278). The comparison nb <= 40 at
   --  mdoc_hash.h 186 computes a bit and asserts nothing; a count above
   --  40 is refused by Index_Bound, its length being zero.
   function Zero_Tail (V : Private_Part) return Boolean is
     (for all B in Block_Index =>
        (if Natural (V.Count) <= B then
           (for all J in 0 .. 63 => Preimage_Byte (V, 64 * B + J) = 0)))
   with Global => null;

   --  The signed length is whole bytes below 4,096 (mdoc_hash.h 191,
   --  extract_vind 299 to 312).
   function Length (V : Private_Part) return Boolean is
     (Length_Ok (Signed_Length (V)))
   with Global => null;

   --  An index into the MSO is below the signed length in bytes
   --  (check_index, mdoc_hash.h 316 to 320). The length counts the 18
   --  bytes of the prefix and the 7 the windows skip, so a window may
   --  reach into the padding (Fact_Wrapper_Lengths, Fact_Padding).
   function Index_Bound (V : Private_Part; K : Index_12) return Boolean is
     (Length_Ok (Signed_Length (V))
      and then K < Byte_Length (Signed_Length (V)))
   with Global => null;

   --  At its index: the key of validFrom, then 20 bytes at most now
   --  (mdoc_hash.h 202 to 208).
   function Valid_From (P : Public_Part; V : Private_Part) return Boolean is
     (Index_Bound (V, V.Valid_From)
      and then Matches (V, V.Valid_From, 0, Valid_From_Key)
      and then Date_Leq (Date_At (V, V.Valid_From, 12), P.Now))
   with Global => null;

   --  At its index: the key of validUntil, then 20 bytes at least now
   --  (mdoc_hash.h 210 to 216).
   function Valid_Until (P : Public_Part; V : Private_Part) return Boolean is
     (Index_Bound (V, V.Valid_Until)
      and then Matches (V, V.Valid_Until, 0, Valid_Until_Key)
      and then Date_Leq (P.Now, Date_At (V, V.Valid_Until, 13)))
   with Global => null;

   --  At its index: the 33 bytes of deviceKeyInfo up to x's head, x as
   --  32 big-endian bytes, 22 58 20, y; x and y equal the device key of
   --  the witness, whose bytes are little-endian (mdoc_hash.h 218 to
   --  227; assert_key, 492 to 498).
   function Device_Key (V : Private_Part) return Boolean is
     (Index_Bound (V, V.Device_Key)
      and then Matches (V, V.Device_Key, 0, Device_Key_Key)
      and then Matches (V, V.Device_Key, 65, Device_Key_Y_Key)
      and then
        (for all B in 0 .. 31 =>
           V.Dpk_X (B) = Mso_At (V, V.Device_Key, 33 + 31 - B)
           and then V.Dpk_Y (B) = Mso_At (V, V.Device_Key, 68 + 31 - B)))
   with Global => null;

   --  At its index: the key valueDigests. The map's size after it is
   --  not read (mdoc_hash.h 229 to 234).
   function Value_Digests (V : Private_Part) return Boolean is
     (Index_Bound (V, V.Value_Digests)
      and then Matches (V, V.Value_Digests, 0, Value_Digests_Key))
   with Global => null;

   --  At its index: 58 20 and 32 bytes, the value digest, equal to the
   --  digest of the item's two blocks (mdoc_hash.h 258 to 275).
   function Value_Digest (V : Private_Part) return Boolean is
     (Index_Bound (V, V.Digest_Index)
      and then Matches (V, V.Digest_Index, 0, Digest_Head)
      and then
        (for all J in 0 .. 31 =>
           Mso_At (V, V.Digest_Index, 2 + J) = Item_Digest (V) (J)))
   with Global => null;

   --  The item: D8 18 58, then byte 4 A4 (byte 3, the length of the
   --  byte string, is not read); its length whole bytes below 4,096;
   --  four slots from byte 5, contiguous, adding up to that length
   --  modulo 4,096; digestID and random each with a key and a length
   --  that agree with their CBOR head; elementIdentifier and
   --  elementValue equal to the public text over the public length,
   --  with the slot's length equal to it modulo 256 (assert_attribute,
   --  mdoc_hash.h 278 to 282 and 392 to 476).
   function Item (P : Public_Part; V : Private_Part) return Boolean is
     (V.Item (0) = 16#D8# and then V.Item (1) = 16#18#
      and then V.Item (2) = 16#58# and then V.Item (4) = 16#A4#
      and then Length_Ok (Item_Length (V))
      and then V.Starts (1) = (5 + V.Lengths (0)) mod 4_096
      and then V.Starts (2) = (V.Starts (1) + V.Lengths (1)) mod 4_096
      and then V.Starts (3) = (V.Starts (2) + V.Lengths (2)) mod 4_096
      and then Byte_Length (Item_Length (V))
               = (V.Starts (3) + V.Lengths (3)) mod 4_096
      and then
        (for all I in Digest_Id_Key'Range =>
           Got (V, Digest_Id_Field, I) = Digest_Id_Key (I))
      and then Cbor_Length_Ok (V, Digest_Id_Field, 9, Atom => True)
      and then
        (for all I in Random_Key'Range =>
           Got (V, Random_Field, I) = Random_Key (I))
      and then Cbor_Length_Ok (V, Random_Field, 7, Atom => False)
      and then
        (for all J in 0 .. 49 =>
           (if J < Natural (P.Id_Len) then
              Got (V, Identifier_Field, J) = Want_Identifier (P, J)))
      and then Field_Length (V, Identifier_Field) mod 256
               = Natural (P.Id_Len)
      and then
        (for all J in 0 .. 76 =>
           (if J < Natural (P.Value_Len) then
              Got (V, Value_Field, J) = Want_Value (P, J)))
      and then Field_Length (V, Value_Field) mod 256
               = Natural (P.Value_Len))
   with Global => null;

   --  The tags: for e, x and y, each split in two 128-bit halves (bit K
   --  of a half the coefficient of x^K), tag = (av + pad) * half in
   --  GF(2^128) (verify_mac and pack, circuits/mac/mac_circuit.h 164 to
   --  186; mdoc_generate_circuit.cc 166 to 169).
   function Tags (P : Public_Part; V : Private_Part) return Boolean is
     (declare
        M : constant Mdoc_Mac.Messages := [V.E, V.Dpk_X, V.Dpk_Y];
      begin
        (for all I in Mdoc_Mac.Message_Index =>
           (for all H in Mdoc_Mac.Half_Index =>
              P.Tags (2 * I + H)
              = GF2_128.Mul (GF2_128.Add (P.Av, V.Pads (I) (H)),
                             Mdoc_Mac.Half (M (I), H)))))
   with Global => null;

   type Clause is
     (Chain_Clause, Zero_Tail_Clause, Length_Clause, Valid_From_Clause,
      Valid_Until_Clause, Device_Key_Clause, Value_Digests_Clause,
      Value_Digest_Clause, Item_Clause, Tags_Clause);

   function Clause_Holds
     (C : Clause; P : Public_Part; V : Private_Part) return Boolean
   is
     (case C is
         when Chain_Clause         => Chain (V),
         when Zero_Tail_Clause     => Zero_Tail (V),
         when Length_Clause        => Length (V),
         when Valid_From_Clause    => Valid_From (P, V),
         when Valid_Until_Clause   => Valid_Until (P, V),
         when Device_Key_Clause    => Device_Key (V),
         when Value_Digests_Clause => Value_Digests (V),
         when Value_Digest_Clause  => Value_Digest (V),
         when Item_Clause          => Item (P, V),
         when Tags_Clause          => Tags (P, V))
   with Global => null;

   function Clauses_Hold (P : Public_Part; V : Private_Part) return Boolean is
     (for all C in Clause => Clause_Holds (C, P, V))
   with Global => null;

   ----------------------------------------------------------------------
   --  3. The relation
   ----------------------------------------------------------------------
   --
   --  What the relation means rests on its public inputs being the ones
   --  the verifier builds. Every clause reads the public part through
   --  Decode_Public, and the claim it makes is about an X in the image
   --  of Mdoc_Inputs.Hash_Inputs: a verifier that passed an Id_Len of
   --  18 would have the clause Item compare the key elementIdentifier
   --  alone. That the decoding of the encoder's output is the request
   --  it encoded is tested, not proved: the harness relation_cases
   --  checks it on every honest case, and the proof belongs with the
   --  emitter's design, where the encoder's contract states its layout.
   --  The same holds of now: its 20 bytes are the relying party's current
   --  time in the form YYYY-MM-DDThh:mm:ssZ, upper-case T and Z, which
   --  the encoder does not check (H_Now_Form, beside
   --  Limit_Date_Separators, the same form on the issuer's side).

   --  The constant one is not an input the circuit checks: it is the
   --  convention of the evaluator and of the verifier
   --  (Mdoc_Inputs.Hash_Inputs puts it first), so it is a precondition
   --  here, not a clause.
   function Hash_Relation (X, W : SAH.Element_Array) return Boolean is
     (Bits (X, W)
      and then Clauses_Hold (Decode_Public (X), Decode_Private (W)))
   with Global => null,
        Pre => Shape_Ok (X, W) and then X (X_One) = GF2_128.One;

   ----------------------------------------------------------------------
   --  4. Consequences of the clauses
   ----------------------------------------------------------------------

   --  The decoding of a byte is faithful: eight elements laid out as
   --  the bits of V read as V.
   procedure Lemma_Byte_At
     (A : SAH.Element_Array; Pos : Natural; V : Unsigned_8)
   with
     Global => null,
     Pre    => Pos >= A'First and then A'Last >= 7
               and then Pos <= A'Last - 7
               and then Byte_Layout (A, Pos, V),
     Post   => Byte_At (A, Pos) = V;

   --  The count is in 1 to 40 whenever the relation holds: a count
   --  outside gives a signed length of zero, and no index is below it.
   --  So the comparison the circuit discards (mdoc_hash.h 186) needs no
   --  fact of the checker.
   procedure Lemma_Count_In_Range (X, W : SAH.Element_Array) with
     Global => null,
     Pre    => Shape_Ok (X, W) and then X (X_One) = GF2_128.One
               and then Hash_Relation (X, W),
     Post   => Decode_Private (W).Count in 1 .. Max_Blocks;

   --  The public lengths the encoder gives: 19 to 50 for the
   --  identifier, 13 to 77 for the value (Mdoc_Inputs.Fits at version
   --  7). The lemma below needs only that each is 1 to 128.
   function Public_Lengths_Ok (P : Public_Part) return Boolean is
     (P.Id_Len in 1 .. 128 and then P.Value_Len in 1 .. 128)
   with Global => null;

   --  The permutation sends the four fields to four different slots.
   function Slots_Distinct (V : Private_Part) return Boolean is
     (for all F in Field =>
        (for all G in Field =>
           (if F /= G then Slot_Of (V, F) /= Slot_Of (V, G))))
   with Global => null;

   --  The clause Item without its arithmetic modulo 4,096 and 256.
   --  Each field's first byte is its key's, which is not zero, and a
   --  byte at 128 or beyond reads as zero: so every field starts inside
   --  the item, and, their keys being different, in its own slot. The
   --  lengths of digestID and random are exact (at most 14 and 264),
   --  and those of the identifier and the value are their public
   --  lengths modulo 256, at most 128. No sum can then pass 4,096: the
   --  starts increase, below 128, and every sum is exact. A field in
   --  one of the first three slots ends where the next starts, below
   --  128, so its length is its public length exactly.
   --
   --  The last slot ends at the length in the item's last eight bytes,
   --  which the clause bounds only by 4,096, not by 128. So the lemma
   --  has a third premise, the item's length at most 128 bytes, which
   --  the clauses do not give: H_Sha256 gives it, since the item's two
   --  blocks are then the issuer's padded item, at most 119 bytes.
   --  Without it, a field in the last slot has its public length
   --  modulo 256 and no more; the bytes past 128 read as zero.
   procedure Lemma_Item_No_Wrap (P : Public_Part; V : Private_Part) with
     Global => null,
     Pre    => Item (P, V) and then Public_Lengths_Ok (P)
               and then Byte_Length (Item_Length (V)) <= 128,
     Post   =>
       Slots_Distinct (V)
       and then V.Starts (1) = 5 + V.Lengths (0)
       and then V.Starts (2) = V.Starts (1) + V.Lengths (1)
       and then V.Starts (3) = V.Starts (2) + V.Lengths (2)
       and then Byte_Length (Item_Length (V)) = V.Starts (3) + V.Lengths (3)
       and then 5 < V.Starts (1) and then V.Starts (1) < V.Starts (2)
       and then V.Starts (2) < V.Starts (3) and then V.Starts (3) < 128
       and then Field_Length (V, Identifier_Field) = Natural (P.Id_Len)
       and then Field_Length (V, Value_Field) = Natural (P.Value_Len);

end Mdoc_Relation.Hash;
